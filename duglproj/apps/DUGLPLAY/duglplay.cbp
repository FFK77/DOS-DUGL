<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="duglplay" />
		<Option pch_mode="2" />
		<Option compiler="djgpp_gnu_gcc_compiler" />
		<Build>
			<Target title="Debug">
				<Option output="duglplay" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Debug/" />
				<Option type="1" />
				<Option compiler="djgpp_gnu_gcc_compiler" />
				<Compiler>
					<Add option="-g" />
					<Add directory="../../../dugl" />
					<Add directory="../../../duglplus" />
				</Compiler>
				<Linker>
					<Add directory="../../../dugl/bin/Debug" />
					<Add directory="../../../duglplus/bin/Debug" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="duglplay" prefix_auto="1" extension_auto="1" />
				<Option object_output="obj/Release/" />
				<Option type="1" />
				<Option compiler="djgpp_gnu_gcc_compiler" />
				<Compiler>
					<Add option="-O2" />
					<Add option="-Weffc++" />
					<Add option="-Wextra" />
					<Add option="-m32" />
					<Add directory="../../../dugl" />
					<Add directory="../../../duglplus" />
				</Compiler>
				<Linker>
					<Add option="-s" />
					<Add option="-m32" />
					<Add directory="../../../dugl/bin/Release" />
					<Add directory="../../../duglplus/bin/Release" />
				</Linker>
			</Target>
		</Build>
		<Compiler>
			<Add option="-Wall" />
		</Compiler>
		<Linker>
			<Add library="dugl" />
			<Add library="duglplus" />
			<Add library="theoradec" />
			<Add library="avformat" />
			<Add library="avcodec" />
			<Add library="avdevice" />
			<Add library="avfilter" />
			<Add library="postproc" />
			<Add library="swresample" />
			<Add library="swscale" />
			<Add library="avutil" />
			<Add library="vorbis" />
			<Add library="vbsenc" />
			<Add library="ogg" />
			<Add library="theora" />
			<Add library="mp3lame" />
			<Add library="x264" />
			<Add library="gthreads" />
			<Add library="opus" />
			<Add library="xml2" />
			<Add library="lzma" />
			<Add library="bz2" />
			<Add library="lz" />
			<Add library="z" />
		</Linker>
		<Unit filename="PARAM.MAC" />
		<Unit filename="duglplay.cc" />
		<Unit filename="duglplay.cfg" />
		<Unit filename="yuv2rgb.asm" />
		<Extensions>
			<lib_finder disable_auto="1" />
		</Extensions>
	</Project>
</CodeBlocks_project_file>
