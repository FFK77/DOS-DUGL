<?xml version="1.0" encoding="UTF-8" standalone="yes" ?>
<CodeBlocks_project_file>
	<FileVersion major="1" minor="6" />
	<Project>
		<Option title="dugl" />
		<Option pch_mode="2" />
		<Option compiler="djgpp_cross_compiler" />
		<Build>
			<Target title="Debug">
				<Option output="bin/Debug/dugl" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj/Debug/" />
				<Option type="2" />
				<Option compiler="djgpp_cross_compiler" />
				<Option createDefFile="1" />
				<Compiler>
					<Add option="-march=k6" />
					<Add option="-Wall" />
					<Add option="-std=gnu++98" />
					<Add option="-m32" />
					<Add option="-g" />
					<Add directory="../../include/libjpeg" />
					<Add directory="../../include/libpng16" />
					<Add directory="../../include" />
				</Compiler>
				<Linker>
					<Add option="-static-libgcc" />
					<Add option="-m32" />
				</Linker>
			</Target>
			<Target title="Release">
				<Option output="bin/Release/dugl" prefix_auto="1" extension_auto="1" />
				<Option working_dir="" />
				<Option object_output="obj/Release/" />
				<Option type="2" />
				<Option compiler="djgpp_cross_compiler" />
				<Option createDefFile="1" />
				<Compiler>
					<Add option="-march=pentium-mmx" />
					<Add option="-fexpensive-optimizations" />
					<Add option="-O3" />
					<Add option="-Wall" />
					<Add option="-m32" />
					<Add directory="../../include/libjpeg" />
					<Add directory="../../include/libpng16" />
					<Add directory="../../include" />
				</Compiler>
				<Linker>
					<Add option="-O3" />
					<Add option="-s" />
					<Add option="-static" />
					<Add option="-m32" />
				</Linker>
			</Target>
		</Build>
		<Linker>
			<Add library="bin/Release/graph.o" />
			<Add library="bin/Release/KEYBOARD.o" />
			<Add library="bin/Release/MOUSE.o" />
			<Add library="bin/Release/TIMER.o" />
			<Add library="bin/Release/ipx.o" />
			<Add library="bin/Release/transf.o" />
			<Add library="bin/Release/imageasm.o" />
		</Linker>
		<Unit filename="CONTROLC.C">
			<Option compilerVar="CC" />
		</Unit>
		<Unit filename="DBMFONT.h" />
		<Unit filename="DCONTAIN.h" />
		<Unit filename="DFONT.ASM">
			<Option compiler="djgpp_cross_compiler" use="1" buildCommand="nasm $file -f coff -Ox -o $object" />
